# Runtime session files — these hold the bridge's bearer TOKENS. Never commit.
# (feedback.jsonl lives here too: prompts and answers are personal data.)
.sessions/

# Per-user files loaded into the system prompt.
lessons.md
instructions.md

# cwd handed to the `claude` subprocess: scratch scripts and screen captures.
.workspace/

# Offline docs corpus (~30 MB of SideFX's documentation text, generated
# locally from the installed Houdini help — theirs to distribute, not ours).
.docs/

# MCP adapter venv (~75 MB). Recreate with the steps in the README:
#   python -m venv .venv-mcp
#   .venv-mcp\Scripts\python.exe -m pip install mcp
.venv-mcp/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Houdini leftovers
*.hip.bak
backup/

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
